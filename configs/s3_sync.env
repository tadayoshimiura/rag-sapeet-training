# S3 同期用の共通設定（アップロード元と先を固定）

AWS_PROFILE=ReadWrite12-480160868418
# 以前のプロファイル（バックアップ用メモ）
# AWS_PROFILE=ReadWrite12-480160868418
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1

# Bedrock（タイムアウト対策）
BEDROCK_READ_TIMEOUT=900
BEDROCK_CONNECT_TIMEOUT=10
BEDROCK_MAX_ATTEMPTS=6
BEDROCK_RETRY_SLEEP=3

# パイプライン全体のリトライ
RUN_PIPELINE_MAX_RETRIES=2
RUN_PIPELINE_RETRY_SLEEP=5

# 問題生成の並列数（1=直列）
MAX_PARALLEL=2
RETRY_PER_JOB=2

# 出力モード（local or s3）
OUTPUT_MODE=local

# 対象講座
COURSE_ID=course_id=test_00
BUCKET=rag-dev-intloop-20251217
PYTHON_BIN=/Users/tadayoshi_miura/workspace/prepare/.venv_py313/bin/python

# ローカルのアップロード元
SRC=/Users/tadayoshi_miura/workspace/prepare/s3/raw/course_packages/course_id=test_00/upload

# S3 のアップロード先
DEST=s3://rag-dev-intloop-20251217/raw/course_packages/course_id=test_00/upload

# 除外パターン
EXCLUDES=( "Icon*" ".DS_Store" "*.m4a" "audio*.txt" "*.zip" )

# 出力（S3→ローカル）同期先/元
KB_SRC=s3://rag-dev-intloop-20251217/course_store/course_id=test_00/knowledge_md/v1
KB_DEST=/Users/tadayoshi_miura/workspace/prepare/s3/course_store/course_id=test_00/knowledge_md/v1
STATUS_SRC=s3://rag-dev-intloop-20251217/processed/course_id=test_00/_status.json
STATUS_DEST=/Users/tadayoshi_miura/workspace/prepare/s3/processed/course_id=test_00/_status.json

# 要約は knowledge_md 配下に保存するため、個別同期は行わない
